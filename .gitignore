# Track the Mirai source and examples listed below.
# Keep locally added datasets, outputs and machine-specific files untracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README_Mirai.md
!/main.py
!/requirements-mirai.txt
!/requirements-conversion.txt
!/requirements-data.txt
!/mirai_training/
!/configs/
/configs/*
!/configs/mirai.yaml
!/configs/embed_conversion.example.json
!/analysis/
/analysis/*
!/analysis/mirai_embed/
/analysis/mirai_embed/*
!/analysis/mirai_embed/adapt_embed.py
!/analysis/mirai_embed/test_adapter.py
!/data/
/data/*
!/data/mirai/
/data/mirai/*
!/data/mirai/metadata.example.csv
!/data/mirai/risk_factors.example.json

# Generated artifacts and machine-specific settings, at any depth.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.env.*
*.local.json
*.local.yaml
*.pt
*.pth
*.ckpt
*.safetensors
*.dcm
*.DCM
*.png
*.jpg
*.jpeg
*.npy
*.npz
*.log
*.pem
*.key
.DS_Store
Thumbs.db
